# Copia este archivo como .env.local (en tu Mac) y pega los mismos valores en Vercel
# (Project → Settings → Environment Variables). Sin las variables de Supabase la web
# arranca en MODO DEMO con ofertas de ejemplo.

# URL pública de la web (sin "/" al final). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Tus integraciones → (tu aplicación) → Credenciales de producción
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Mercado Pago → Tus integraciones → Webhooks → "Clave secreta"
MP_WEBHOOK_SECRET=

# Clave que comparten Apps Script y la web para publicar ofertas. Inventa una larga
# (por ejemplo, 40 letras y números al azar) y pon la misma en Config.gs → WEB_API_SECRET.
OFERTAS_API_SECRET=

# Opcional: fotos de mejor calidad desde Unsplash (https://unsplash.com/developers).
# Sin esta clave se usan fotos de Wikipedia.
UNSPLASH_ACCESS_KEY=

# Opcional: píxel de Meta (Facebook/Instagram) para medir anuncios.
# Meta → Administrador de eventos → tu píxel → "Identificador del conjunto de datos" (solo números).
NEXT_PUBLIC_META_PIXEL_ID=
